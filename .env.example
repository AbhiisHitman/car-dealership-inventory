# Postgres connection string (Neon, Supabase, RDS, local Postgres...).
# Leave empty to use the embedded PGlite Postgres stored in ./.data/pglite.
DATABASE_URL=

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Port for the local API server (Vite proxies /api here).
API_PORT=4000

# Optional: an admin account created on first start if it does not exist.
ADMIN_EMAIL=admin@dealership.test
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Showroom Admin
